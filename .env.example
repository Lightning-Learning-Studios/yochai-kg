# Yochai Open KG gateway — environment.
# Copy to .env and fill in. NEVER commit real secrets.

# --- Neo4j (read-only) -------------------------------------------------------
# Use a database whose ACCESS is READ ONLY (ALTER DATABASE neo4j SET ACCESS READ ONLY).
NEO4J_YOCHAI_URI=bolt://your-neo4j-host:7687
NEO4J_YOCHAI_USERNAME=neo4j
NEO4J_YOCHAI_PASSWORD=
NEO4J_YOCHAI_DATABASE=neo4j

# --- Embeddings (DeepInfra BGE-M3) -------------------------------------------
DEEPINFRA_API_KEY=

# --- Gateway behavior --------------------------------------------------------
GATEWAY_NEO4J_MAX_POOL=12
GATEWAY_NEO4J_QUERY_TIMEOUT_SECONDS=10
GATEWAY_SIMILARITY_THRESHOLD=0.40
GATEWAY_DEFAULT_LIMIT=8
GATEWAY_MAX_LIMIT=25
YOCHAI_APP_URL=https://yochai.lightningstudios.ai

# --- Auth (free API keys) ----------------------------------------------------
# When true, the HTTP transport requires a key in `x-api-key` or `Authorization: Bearer`.
GATEWAY_REQUIRE_API_KEY=false
GATEWAY_API_KEYS=

# --- Transport ---------------------------------------------------------------
# stdio (local / Claude Desktop) or http (hosted)
MCP_TRANSPORT=stdio
HOST=0.0.0.0
PORT=8000
