# Yochai Open KG gateway — environment.
# Copy to .env and fill in. NEVER commit real secrets.

# --- Neo4j (read-only) -------------------------------------------------------
# Use a database whose ACCESS is READ ONLY (ALTER DATABASE neo4j SET ACCESS READ ONLY).
NEO4J_YOCHAI_URI=bolt://your-neo4j-host:7687
NEO4J_YOCHAI_USERNAME=neo4j
NEO4J_YOCHAI_PASSWORD=
NEO4J_YOCHAI_DATABASE=neo4j

# --- Embeddings (DeepInfra BGE-M3) -------------------------------------------
DEEPINFRA_API_KEY=

# --- Gateway behavior --------------------------------------------------------
GATEWAY_NEO4J_MAX_POOL=12
GATEWAY_NEO4J_QUERY_TIMEOUT_SECONDS=10
GATEWAY_SIMILARITY_THRESHOLD=0.40
GATEWAY_DEFAULT_LIMIT=8
GATEWAY_MAX_LIMIT=25
YOCHAI_APP_URL=https://yochai.lightningstudios.ai

# --- Auth (free API keys) ----------------------------------------------------
# When true, the HTTP transport requires a key in `x-api-key` or `Authorization: Bearer`.
# Keys are accepted if in this static list OR active in the Supabase key store below.
GATEWAY_REQUIRE_API_KEY=false
GATEWAY_API_KEYS=

# --- API-key request form + Slack approval (apikeys/) ------------------------
# Supabase store (run migrations/001_api_keys.sql first). Service role — server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Slack app: chat:write scope, Interactivity → POST <host>/slack/interactions, bot in #yochai.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=#yochai
# Email the approved key via Mailchimp Transactional (Mandrill) — same key the rest
# of the app uses. Without it, the key is shown in the Slack thread for manual delivery.
MAILCHIMP_API_KEY=
MAILCHIMP_FROM_EMAIL=support@lightninginspiration.com
MAILCHIMP_FROM_NAME=Yochai Open KG

# Origins allowed to POST the request form cross-origin (e.g. the Yochai app).
GATEWAY_CORS_ORIGINS=https://yochai.lightningstudios.ai,http://localhost:8080,http://localhost:5173

# --- Transport ---------------------------------------------------------------
# stdio (local / Claude Desktop) or http (hosted)
MCP_TRANSPORT=stdio
HOST=0.0.0.0
PORT=8000
